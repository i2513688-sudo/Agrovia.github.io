msgid "Agrovia | Marketplace Agrícola"
msgstr "Agrovia | Agricultural Marketplace"

msgid "Conectamos el campo"
msgstr "Connecting the countryside"

msgid "con el mercado."
msgstr "to the marketplace."

msgid "Agrovia es una plataforma web que conecta productores agrícolas con compradores, facilitando la comercialización de productos agrícolas."
msgstr "Agrovia is a web platform that connects agricultural producers with buyers, making it easier to market agricultural products."

msgid "Ver lotes disponibles"
msgstr "Browse available lots"

msgid "Campo sembrado"
msgstr "Planted field"

msgid "¿Qué puedes hacer en Agrovia?"
msgstr "What can you do with Agrovia?"

msgid "Productores"
msgstr "Producers"

msgid "Registra tus predios, cultivos y solicitudes de lotes para ofrecer tus productos agrícolas."
msgstr "Register your farms, crops, and lot requests to offer your agricultural products."

msgid "Compradores"
msgstr "Buyers"

msgid "Encuentra productos agrícolas y lotes disponibles de diferentes productores."
msgstr "Find agricultural products and available lots from different producers."

msgid "Operaciones"
msgstr "Operations"

msgid "Gestiona cotizaciones, reservas, operaciones comerciales y pagos."
msgstr "Manage quotes, reservations, commercial transactions, and payments."

msgid "Entregas"
msgstr "Deliveries"

msgid "Realiza el seguimiento de las entregas y registra la recepción de los productos."
msgstr "Track deliveries and confirm receipt of products."

msgid "Productos agrícolas"
msgstr "Agricultural products"

msgid "Ver todos"
msgstr "View all"

msgid "Producto agrícola disponible para comercialización."
msgstr "Agricultural product available for sale."

msgid "No hay productos"
msgstr "No products found"

msgid "Todavía no existen productos activos registrados en la base de datos."
msgstr "There are no active products registered in the database yet."

